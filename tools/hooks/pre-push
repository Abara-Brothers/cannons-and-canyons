#!/usr/bin/env bash
#
# Refuse to push `main` unless the full suite passes.
#
# WHY THIS EXISTS (RISK-013, opened 2026-08-15): Render auto-deploys `main`, and
# it does NOT wait for CI. Measured that day — a push was serving production in
# about 60 seconds while its GitHub Actions run was still going, finally passing
# at 3m28s, two and a half minutes after players already had the code. So CI
# reports on production; it does not protect it. **Pushing IS deploying.**
#
# That left "run the tests first" as pure discipline. This hook makes it the
# default instead. It is not a substitute for a real gate — Render's wait-for-CI
# setting, or branch protection requiring the check, are the durable fixes and
# both live in a dashboard. This is the part that can live in the repository.
#
# INSTALL (once per clone):
#     git config core.hooksPath tools/hooks
#
# BYPASS, when you mean it (a docs-only push, or an emergency revert that must
# ship now):
#     git push --no-verify
#
# Note an emergency revert is exactly the case where you may not want to wait
# two minutes — hence the bypass, and hence this text telling you it exists.

set -uo pipefail

REMOTE_REF_DEPLOYS="refs/heads/main"
ZERO="0000000000000000000000000000000000000000"

# git feeds us "<local ref> <local sha> <remote ref> <remote sha>" per ref.
deploying=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  [ "$remote_ref" != "$REMOTE_REF_DEPLOYS" ] && continue
  # A branch deletion pushes the zero sha and ships nothing.
  [ "$local_sha" = "$ZERO" ] && continue
  deploying=1
done

if [ "$deploying" -eq 0 ]; then
  exit 0                     # not main: nothing auto-deploys, nothing to guard
fi

cd "$(git rev-parse --show-toplevel)" || exit 1

echo "pre-push: this push deploys to production — running the suite first."
echo "          (bypass with --no-verify; see tools/hooks/pre-push)"
echo

if bash test/run-all.sh; then
  echo
  echo "pre-push: suite green — pushing."
  exit 0
fi

cat >&2 <<'EOF'

──────────────────────────────────────────────────────────────────────────
PUSH REFUSED — the suite failed, and this push would have gone live.

Render auto-deploys `main` without waiting for CI, so a push is a deploy:
this would have been serving players within about a minute, and CI would
have told you it was broken a couple of minutes AFTER that.

Fix it, or push deliberately with:  git push --no-verify
──────────────────────────────────────────────────────────────────────────
EOF
exit 1
