{
  "name": "cannons-and-canyons",
  "version": "1.0.0",
  "build": 1,
  "description": "Cannons & Canyons — real-time artillery combat over colossal destructible mountains: duel, 4-player free-for-all, co-op boss fight, alien invasion and artillery golf. Mobile-first, landscape-only, join by code. Free — no ads, no in-app purchases, no tracking.",
  "author": "Abara Brothers",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "./test/run-all.sh",
    "test:hitbox": "node test/hitbox.mjs",
    "test:sim": "node test/sim.mjs",
    "test:resume": "node test/resume_test.mjs",
    "test:takeover": "node test/resume_takeover.mjs",
    "test:ffa": "node test/ffa.mjs",
    "test:ffa-elim": "node test/ffa_elim.mjs",
    "test:boss": "node test/boss.mjs",
    "test:golf": "node test/golf.mjs",
    "test:horde": "node test/horde.mjs",
    "test:batch6": "node test/batch6.mjs",
    "test:golf-hazards": "node test/golf_hazards.mjs",
    "test:security": "node test/security.mjs",
    "test:shutdown": "node test/shutdown.mjs",
    "test:house-rules": "node test/house-rules.mjs",
    "version:sync": "node tools/sync-version.mjs",
    "version:bump": "node tools/sync-version.mjs --bump"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "web-push": "^3.6.7",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/push-notifications": "^8.1.2"
  }
}
